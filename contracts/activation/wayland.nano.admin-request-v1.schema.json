{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wayland.nano/contracts/wayland.nano.admin-request-v1.schema.json",
  "title": "wayland.nano.admin-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "admin_id", "admin_epoch", "operation", "operation_id", "nonce", "issued_at", "not_after", "before_digest", "after_digest", "reason", "key_id", "alg", "signature"],
  "properties": {
    "schema": {"const": "wayland.nano.admin-request/v1"}, "admin_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "admin_epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "operation": {"enum": ["enroll_issuer", "grant_project", "rotate_key", "revoke_key", "revoke_issuer", "recover_root", "replace_root", "rollback", "enable_artifact", "disable_artifact"]},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}, "nonce": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "not_after": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "before_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "after_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256}, "key_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "alg": {"const": "Ed25519"}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  }
}
